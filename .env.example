# Copy this file to .env and fill in ONE of the two keys. Never commit .env.

# Groq key (free to start): https://console.groq.com  ->  API Keys
GROQ_API_KEY=
# OpenAI key (needs billing credits): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider to use: auto (Groq if its key is set, else OpenAI) | groq | openai
LLM_PROVIDER=auto
# Model names. Providers retire models from time to time; if you get a
# "model_not_found" error, check the provider's model list and change these.
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini

# --- optional tuning (defaults shown) ---
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHROMA_PERSIST_DIR=data/vector_store
# UPLOAD_DIR=data/uploads
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=4
# MIN_SIMILARITY=0.25
# MAX_UPLOAD_MB=10
# LLM_MAX_TOKENS=1500
